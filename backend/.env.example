# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173

# Database Configuration (Prisma SQLite for local dev / PostgreSQL for prod)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neerajpharma_db?schema=public
DATABASE_URL="file:./dev.db"

# Authentication (JWT & Security)
JWT_SECRET=super-secret-jwt-key-neerajpharma-change-in-production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Call Configuration
CALL_TIMEOUT_SECONDS=30

# WebRTC & Coturn (STUN / TURN Server)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:coturn.neerajpharma.com:3478
TURN_USERNAME=neerajpharma_user
TURN_PASSWORD=neerajpharma_secret_key
