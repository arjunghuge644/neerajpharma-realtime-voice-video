# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neerajpharma_db?schema=public

# Authentication (JWT & Security)
JWT_SECRET=super-secret-jwt-key-neerajpharma-change-in-production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# WebRTC & Coturn (STUN / TURN Server)
STUN_SERVER_URL=stun:stun.l.google.com:19302
COTURN_ENABLED=false
COTURN_URL=turn:coturn.neerajpharma.com:3478
COTURN_USERNAME=neerajpharma_user
COTURN_CREDENTIAL=neerajpharma_secret_key

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
CALL_RINGING_TIMEOUT_MS=30000
