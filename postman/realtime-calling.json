{
  "info": {
    "_postman_id": "neerajpharma-realtime-calling-v1",
    "name": "NeerajPharma Real-Time Voice & Video Calling Platform",
    "description": "Complete REST API & Socket.IO test collection for NeerajPharma Telemedicine calling backend module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "callSessionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe (Patient)\",\n  \"email\": \"patient_new@neerajpharma.com\",\n  \"password\": \"Patient123!\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('patientToken', jsonData.data.token);",
                  "    console.log('Patient Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@neerajpharma.com\",\n  \"password\": \"Patient123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('doctorToken', jsonData.data.token);",
                  "    console.log('Doctor Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@neerajpharma.com\",\n  \"password\": \"Doctor123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('Admin Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@neerajpharma.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Appointments",
      "item": [
        {
          "name": "List User Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.appointments && jsonData.data.appointments.length > 0) {",
                  "    pm.collectionVariables.set('appointmentId', jsonData.data.appointments[0].id);",
                  "    console.log('Saved Appointment ID:', jsonData.data.appointments[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Calls",
      "item": [
        {
          "name": "Initiate Voice Call",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.callSession) {",
                  "    pm.collectionVariables.set('callSessionId', jsonData.data.callSession.id);",
                  "    console.log('Saved Call Session ID:', jsonData.data.callSession.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"callType\": \"VOICE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls"]
            }
          }
        },
        {
          "name": "Initiate Video Call",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.callSession) {",
                  "    pm.collectionVariables.set('callSessionId', jsonData.data.callSession.id);",
                  "    console.log('Saved Call Session ID:', jsonData.data.callSession.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"callType\": \"VIDEO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls"]
            }
          }
        },
        {
          "name": "Get ICE Servers Config",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/ice-servers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "ice-servers"]
            }
          }
        },
        {
          "name": "Get Call Session Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/{{callSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "{{callSessionId}}"]
            }
          }
        },
        {
          "name": "End Call Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/{{callSessionId}}/end",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "{{callSessionId}}", "end"]
            }
          }
        },
        {
          "name": "Get User Call History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Dashboard",
      "item": [
        {
          "name": "Get Aggregate Call Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "stats"]
            }
          }
        },
        {
          "name": "Get Active Calls List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "active"]
            }
          }
        },
        {
          "name": "Get Complete System Call History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Admin Call Details Inspection",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/{{callSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "{{callSessionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Socket.IO Real-Time Signaling",
      "item": [
        {
          "name": "1. Patient - Emit call:initiate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call:initiate\",\n  \"payload\": {\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"callType\": \"VIDEO\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/call:initiate",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "call:initiate"]
            },
            "description": "In Postman Socket.IO connection tab (Patient), emit event 'call:initiate' with this JSON payload."
          }
        },
        {
          "name": "2. Doctor - Emit call:accept",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call:accept\",\n  \"payload\": {\n    \"callSessionId\": \"{{callSessionId}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/call:accept",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "call:accept"]
            },
            "description": "In Postman Socket.IO connection tab (Doctor), emit event 'call:accept' with this JSON payload."
          }
        },
        {
          "name": "3. Patient - Emit webrtc:offer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"webrtc:offer\",\n  \"payload\": {\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"sdp\": {\n      \"type\": \"offer\",\n      \"sdp\": \"v=0\\r\\nsample_sdp_offer\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/webrtc:offer",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "webrtc:offer"]
            },
            "description": "In Postman Socket.IO connection tab (Patient), emit event 'webrtc:offer' with this JSON payload."
          }
        },
        {
          "name": "4. Doctor - Emit webrtc:answer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"webrtc:answer\",\n  \"payload\": {\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"sdp\": {\n      \"type\": \"answer\",\n      \"sdp\": \"v=0\\r\\nsample_sdp_answer\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/webrtc:answer",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "webrtc:answer"]
            },
            "description": "In Postman Socket.IO connection tab (Doctor), emit event 'webrtc:answer' with this JSON payload."
          }
        },
        {
          "name": "5. Peer - Emit webrtc:ice-candidate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"webrtc:ice-candidate\",\n  \"payload\": {\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"candidate\": {\n      \"candidate\": \"candidate:123456789 1 udp 2122260223 192.168.1.5 50000 typ host\",\n      \"sdpMid\": \"0\",\n      \"sdpMLineIndex\": 0\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/webrtc:ice-candidate",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "webrtc:ice-candidate"]
            },
            "description": "In Postman Socket.IO connection tab, emit event 'webrtc:ice-candidate' with this JSON payload."
          }
        },
        {
          "name": "6. Either Peer - Emit call:end",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call:end\",\n  \"payload\": {\n    \"callSessionId\": \"{{callSessionId}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/socket.io/call:end",
              "host": ["{{baseUrl}}"],
              "path": ["socket.io", "call:end"]
            },
            "description": "In Postman Socket.IO connection tab, emit event 'call:end' with this JSON payload."
          }
        }
      ]
    }
  ]
}
