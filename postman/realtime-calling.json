{
  "info": {
    "_postman_id": "neerajpharma-realtime-calling-v1",
    "name": "NeerajPharma Real-Time Voice & Video Calling Platform",
    "description": "Complete REST API & Socket.IO test collection for NeerajPharma Telemedicine calling backend module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "callSessionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe (Patient)\",\n  \"email\": \"patient_new@neerajpharma.com\",\n  \"password\": \"Patient123!\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('patientToken', jsonData.data.token);",
                  "    console.log('Patient Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@neerajpharma.com\",\n  \"password\": \"Patient123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('doctorToken', jsonData.data.token);",
                  "    console.log('Doctor Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@neerajpharma.com\",\n  \"password\": \"Doctor123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('Admin Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@neerajpharma.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Appointments",
      "item": [
        {
          "name": "List User Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.appointments && jsonData.data.appointments.length > 0) {",
                  "    pm.collectionVariables.set('appointmentId', jsonData.data.appointments[0].id);",
                  "    console.log('Saved Appointment ID:', jsonData.data.appointments[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Calls",
      "item": [
        {
          "name": "Initiate Voice Call",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.callSession) {",
                  "    pm.collectionVariables.set('callSessionId', jsonData.data.callSession.id);",
                  "    console.log('Saved Call Session ID:', jsonData.data.callSession.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"callType\": \"VOICE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls"]
            }
          }
        },
        {
          "name": "Initiate Video Call",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.callSession) {",
                  "    pm.collectionVariables.set('callSessionId', jsonData.data.callSession.id);",
                  "    console.log('Saved Call Session ID:', jsonData.data.callSession.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"callType\": \"VIDEO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls"]
            }
          }
        },
        {
          "name": "Get Call Session Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/{{callSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "{{callSessionId}}"]
            }
          }
        },
        {
          "name": "End Call Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/{{callSessionId}}/end",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "{{callSessionId}}", "end"]
            }
          }
        },
        {
          "name": "Get User Call History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/calls/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Dashboard",
      "item": [
        {
          "name": "Get Aggregate Call Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "stats"]
            }
          }
        },
        {
          "name": "Get Active Calls List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "active"]
            }
          }
        },
        {
          "name": "Get Complete System Call History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Admin Call Details Inspection",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/calls/{{callSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "calls", "{{callSessionId}}"]
            }
          }
        }
      ]
    }
  ]
}

